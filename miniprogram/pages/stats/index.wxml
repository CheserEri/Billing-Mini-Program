<!--pages/stats/index.wxml-->
<view class="page-stats">

  <!-- 月份选择 -->
  <view class="month-picker">
    <picker mode="date" fields="month" value="{{month}}" bindchange="onMonthChange">
      <text class="month-text">{{month}} ▾</text>
    </picker>
  </view>

  <!-- 预算总览卡片 -->
  <view class="budget-card">
    <view class="budget-header-row">
      <text class="budget-label">{{monthNum}}月总支出</text>
      <text class="budget-total">预算 ¥{{totalBudget}}</text>
    </view>
    <view class="budget-amount">¥{{totalExpense}}</view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{budgetPercent}}%; background: {{budgetPercent > 80 ? '#D85A30' : '#EF9F27'}};"></view>
    </view>
    <view class="budget-alert-text" wx:if="{{budgetPercent > 80}}">
      已使用 {{budgetPercent}}%，还剩 ¥{{budgetRemain}}
    </view>
  </view>

  <!-- 分类支出 -->
  <view class="section-title">分类支出</view>

  <view class="loading-tip" wx:if="{{loading}}">加载中...</view>

  <view class="bar-chart" wx:if="{{!loading}}">
    <view class="bar-row" wx:for="{{categoryStats}}" wx:key="categoryId">
      <text class="bar-label">{{item.name}}</text>
      <view class="bar-track">
        <view class="bar-fill" style="width: {{item.percent}}%; background: {{item.color}};"></view>
      </view>
      <text class="bar-amt">¥{{item.amountText}}</text>
    </view>
    <view class="empty-tip" wx:if="{{categoryStats.length === 0}}">暂无数据</view>
  </view>

  <!-- 预算预警 -->
  <view class="section-title" wx:if="{{budgetList.length > 0}}">预算预警</view>

  <view class="budget-list">
    <view class="budget-row" wx:for="{{budgetList}}" wx:key="categoryId">
      <view class="budget-row-header">
        <text class="budget-name">{{item.categoryName}}</text>
        <text class="budget-nums">¥{{item.spentText}} / ¥{{item.amount}}</text>
      </view>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{item.percent}}%; background: {{item.color}};"></view>
      </view>
      <view class="budget-alert" wx:if="{{item.overBudget}}">
        ⚠ 已超出预算 ¥{{item.overAmount}}
      </view>
    </view>
  </view>

</view>
