/* pages/stats/index.wxss */

.page-stats {
  padding-bottom: 30rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

.month-picker {
  background: #fff;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #E8E8E8;
}

.month-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.budget-card {
  background: #fff;
  border: 1rpx solid #E8E8E8;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin: 24rpx 28rpx 0;
}

.budget-header-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.budget-label {
  font-size: 28rpx;
  color: #999;
}

.budget-total {
  font-size: 26rpx;
  color: #999;
}

.budget-amount {
  font-size: 52rpx;
  font-weight: 600;
  color: #333;
  margin: 10rpx 0;
}

.progress-bar {
  height: 12rpx;
  background: #EAEAEA;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s;
}

.budget-alert-text {
  font-size: 26rpx;
  color: #993C1D;
  margin-top: 10rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #999;
  padding: 24rpx 32rpx 12rpx;
}

.loading-tip, .empty-tip {
  text-align: center;
  color: #999;
  padding: 60rpx 0;
  font-size: 30rpx;
}

.bar-chart {
  padding: 0 32rpx;
}

.bar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.bar-label {
  font-size: 26rpx;
  color: #999;
  width: 80rpx;
  flex-shrink: 0;
}

.bar-track {
  flex: 1;
  background: #EAEAEA;
  border-radius: 6rpx;
  height: 32rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 6rpx;
}

.bar-amt {
  font-size: 26rpx;
  color: #999;
  width: 120rpx;
  text-align: right;
  flex-shrink: 0;
}

.budget-list {
  padding: 0 28rpx;
}

.budget-row {
  background: #fff;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.budget-row-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.budget-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.budget-nums {
  font-size: 26rpx;
  color: #999;
}

.budget-alert {
  font-size: 26rpx;
  color: #993C1D;
  margin-top: 10rpx;
}
