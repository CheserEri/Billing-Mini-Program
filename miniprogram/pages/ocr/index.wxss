/* pages/ocr/index.wxss */

.page-ocr {
  padding-bottom: 30rpx;
  background: #F5F5F5;
  min-height: 100vh;
}

.upload-area {
  margin: 24rpx 28rpx;
  background: #fff;
  border: 3rpx dashed #D0D0D0;
  border-radius: 24rpx;
  padding: 100rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.upload-icon {
  font-size: 96rpx;
}

.upload-text {
  font-size: 34rpx;
  color: #333;
  font-weight: 600;
}

.upload-hint {
  font-size: 28rpx;
  color: #999;
}

.preview-box {
  margin: 24rpx 28rpx 0;
  background: #B4B2A9;
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
  height: 280rpx;
}

.preview-img {
  width: 100%;
  height: 280rpx;
}

.status-bar {
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-bar.recognizing { background: #FAEEDA; color: #854F0B; }
.status-bar.success { background: #EAF3DE; color: #3B6D11; }

.result-card {
  background: #fff;
  margin: 0 28rpx;
  padding: 20rpx 28rpx;
  border: 1rpx solid #E8E8E8;
  border-radius: 0 0 24rpx 24rpx;
}

.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.result-row:last-child { border-bottom: none; }

.result-key {
  font-size: 28rpx;
  color: #999;
}

.result-val {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.result-val.amount {
  font-size: 36rpx;
  color: #A32D2D;
}

.badge {
  font-size: 24rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: #EAF3DE;
  color: #3B6D11;
}

.badge.food { background: #FAEEDA; color: #854F0B; }
.badge.shop { background: #FBEAF0; color: #993556; }
.badge.trans { background: #E6F1FB; color: #185FA5; }

.section-label {
  font-size: 28rpx;
  color: #999;
  padding: 24rpx 32rpx 12rpx;
}

.tag-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  padding: 0 28rpx;
}

.tag {
  font-size: 28rpx;
  padding: 14rpx 28rpx;
  border-radius: 24rpx;
  border: 1rpx solid #D0D0D0;
  color: #666;
  background: #fff;
}

.tag.active {
  background: #333;
  color: #fff;
  border-color: #333;
}

.confirm-btn {
  margin: 36rpx 28rpx 0;
  padding: 28rpx;
  background: #333;
  color: #fff;
  border-radius: 20rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

.confirm-btn:active { opacity: 0.8; }

.retake-btn {
  text-align: center;
  padding: 28rpx;
  font-size: 28rpx;
  color: #999;
}

.manual-entry {
  text-align: center;
  padding: 28rpx;
  font-size: 30rpx;
  color: #999;
  margin-top: 24rpx;
}
