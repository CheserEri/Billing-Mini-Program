<!--pages/profile/index.wxml-->
<view class="page-profile">

  <!-- 用户信息区 -->
  <view class="user-section">
    <view class="avatar-wrap" wx:if="{{!userInfo}}" bindtap="getUserProfile">
      <text class="avatar-placeholder">👤</text>
    </view>
    <image class="avatar" wx:else src="{{userInfo.avatarUrl}}" mode="aspectFill" />
    <view class="user-info">
      <text class="nickname" wx:if="{{userInfo}}">{{userInfo.nickName}}</text>
      <text class="nickname" wx:else bindtap="getUserProfile">点击登录</text>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-section">
    <view class="menu-item" wx:for="{{menuList}}" wx:key="id" data-id="{{item.id}}" bindtap="onMenuTap">
      <text class="menu-icon">{{item.icon}}</text>
      <text class="menu-name">{{item.name}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

</view>
