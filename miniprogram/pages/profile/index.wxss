/* pages/profile/index.wxss */

.page-profile {
  padding-bottom: 30rpx;
}

/* 用户信息区 */
.user-section {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #4A90D9, #357ABD);
  padding: 60rpx 40rpx;
}

.avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-placeholder {
  font-size: 60rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.user-info {
  margin-left: 30rpx;
}

.nickname {
  font-size: 34rpx;
  color: #fff;
  font-weight: bold;
}

/* 菜单列表 */
.menu-section {
  background: #fff;
  margin-top: 20rpx;
  border-radius: 16rpx 16rpx 0 0;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}
